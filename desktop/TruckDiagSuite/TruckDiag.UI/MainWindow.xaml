<Window x:Class="TruckDiag.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TruckDiagSuite (read-only)" Height="650" Width="1000">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open Capture..." Click="OnOpenCapture" />
            <Button Content="Identify Vehicle" Click="OnIdentify" />
            <Button Content="Read Faults" Click="OnReadFaults" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready (read-only)." /></StatusBarItem>
        </StatusBar>

        <!-- Six read-only tabs. There is intentionally no Programming tab. -->
        <TabControl>
            <TabItem Header="Dashboard">
                <TextBlock x:Name="DashboardText" Margin="12" Text="Connect a capture to begin." />
            </TabItem>

            <TabItem Header="Vehicle Discovery">
                <DataGrid x:Name="ModulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceAddress}" Width="80" />
                        <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Software ID" Binding="{Binding SoftwareId}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Fault Codes">
                <DataGrid x:Name="FaultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SPN" Binding="{Binding Spn}" Width="80" />
                        <DataGridTextColumn Header="FMI" Binding="{Binding Fmi}" Width="60" />
                        <DataGridTextColumn Header="OC" Binding="{Binding OccurrenceCount}" Width="50" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Live Data">
                <DataGrid x:Name="LiveGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N3}" Width="120" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Logs">
                <TextBox x:Name="LogBox" Margin="6" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True" />
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="12">
                    <TextBlock Text="Adapter: RP1210 / J2534 (receive + Request-PGN only)" />
                    <TextBlock Text="Mode: read-only diagnostics" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
